{
  "name": "scfi-seafi-bai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "HISTORY" }],
  "triggers": {
    // UTC 기준. 요일은 숫자가 아니라 이름으로 쓴다(Cloudflare는 1=일요일이라 헷갈림).
    // 월 10:00(KST, BAI), 금 18:00(KST, SCFI·SEAFI), 토 10:00(KST, 누락 보완)
    "crons": ["0 1 * * MON", "0 9 * * FRI", "0 1 * * SAT"]
  }
}
