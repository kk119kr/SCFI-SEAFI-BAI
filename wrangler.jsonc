{
  "name": "scfi-seafi-bai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "HISTORY" }],
  "triggers": {
    // UTC 기준. 화 10:00(KST, BAI), 금 18:00(KST, SCFI·SEAFI), 토 10:00(KST, 누락 보완)
    "crons": ["0 1 * * 2", "0 9 * * 5", "0 1 * * 6"]
  }
}
